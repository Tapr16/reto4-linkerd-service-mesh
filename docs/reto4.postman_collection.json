{
  "info": {
    "name": "Reto 4 - Enrutamiento por cabeceras (Linkerd)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [{ "key": "base", "value": "http://localhost:8080" }],
  "item": [
    {
      "name": "1. Sin cabecera (esperado v1)",
      "request": { "method": "GET", "header": [], "url": "{{base}}/" }
    },
    {
      "name": "2. X-Feature-Flag: new-version (esperado v2)",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Feature-Flag", "value": "new-version" }],
        "url": "{{base}}/"
      }
    },
    {
      "name": "3. X-Feature-Flag: otro-valor (esperado v1)",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Feature-Flag", "value": "otro-valor" }],
        "url": "{{base}}/"
      }
    },
    {
      "name": "4. User-Agent: experimental (esperado v2)",
      "request": {
        "method": "GET",
        "header": [{ "key": "User-Agent", "value": "experimental" }],
        "url": "{{base}}/"
      }
    }
  ]
}
